APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Conexión al CRM (catálogo de productos) ──────────────────────────────
# Base de la API pública del CRM (CRM_AUTOMATIZADOR), SIN el slug del tenant.
# Ej: si el CRM está en https://midominio.com, esto es https://midominio.com/api/v1
CRM_BASE_URL=https://tu-crm.com/api/v1

# Slug del tenant/negocio dentro del CRM.
CRM_TENANT_SLUG=mi-negocio

# API Key de SOLO LECTURA (CRM → Configuración → Prompt → API Key de
# consulta). A propósito NO es el API Token general — este proyecto solo
# necesita leer el catálogo, nunca escribir.
CRM_CATALOG_API_KEY=

# Slug del catálogo a mostrar en la landing — el que ves en el sidebar
# "Catálogos" del CRM (ej. la captura mostraba "MX  Productos_MXN", así que
# el slug probablemente es algo como "productos_mxn").
CRM_CATALOG_MODULE=productos_mxn

# ── Panel admin oculto ────────────────────────────────────────────────────
# Segmento de URL del panel — no aparece enlazado en ningún lado de la
# landing pública. Cámbialo por algo no adivinable antes de ir a producción.
ADMIN_PANEL_PATH=panel-4life

# Credenciales del único usuario admin. Se aplican corriendo:
#   php artisan db:seed --class=AdminUserSeeder
# (vuelve a correrlo cuando cambies ADMIN_PASSWORD aquí, para actualizarla)
ADMIN_EMAIL=admin@4life.local
ADMIN_PASSWORD=cambia-esta-clave

# ── Groq (IA para simplificar descripciones del catálogo) ────────────────
# Se usa SOLO para generar la versión corta/en puntos de la descripción de
# cada producto — nunca toca el texto original del catálogo. Se genera una
# vez al guardar cambios en el panel y queda cacheada en la base de datos,
# así que no se vuelve a llamar a la API a menos que el campo esté vacío.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
